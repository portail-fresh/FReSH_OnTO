@prefix dcterms: <http://purl.org/dc/terms/> .
    @prefix dc: <http://purl.org/dc/elements/1.1/> .
    @prefix eur: <http://data.europa.eu/8mn/euroscivoc/> .
    @prefix fresh: <https://purl.org/fresh/FReSH_OnTO#> .
    @prefix term: <https://purl.org/fresh/terminologies/> .
    @prefix mesh: <http://id.nlm.nih.gov/mesh/> .
    @prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
    @prefix skos: <http://www.w3.org/2004/02/skos/core#> .
    @prefix vocab: <https://portail-fresh.fr/vocab/> .
    @prefix owl: <http://www.w3.org/2002/07/owl#> .
    @prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
    @prefix pav: <http://purl.org/pav/> .
    @prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
    @prefix tfo: <https://purl.org/fresh/Termino_FReSH_OnTO#> .

    fresh:terminologies rdf:type owl:Class .


    tfo:DatasetPIDSchema rdf:type owl:Class ;
        rdfs:subClassOf fresh:terminologies ;
        dcterms:identifier term:FDS ;
        dcterms:title 'Type d\'identifiant du jeu de données'@fr , 'Identifier type of the dataset'@en ;
        dcterms:description 'Concepts utilisés pour décrire le champ DatasetPIDSchema du schéma de métadonnées FReSH.'@fr , 'Terms used to describe the field DatasetPIDSchema in the FReSH metadata schema.'@en ;
        dcterms:creator fresh: ;
        pav:createdOn "2026-01-05"^^xsd:date ;
        pav:lastUpdatedOn '2026-04-07' ;


    
 
        fresh:metadataConcerned 'DatasetPIDSchema';


        
 
        dcterms:license 'https://creativecommons.org/licenses/by-nc-sa/4.0/' .


            
        tfo:FDS1444 rdf:type owl:NamedIndividual, tfo:DatasetPIDSchema ;
            skos:prefLabel 'DOI'@fr , 'DOI'@en ;
            dc:title 'DOI'@fr , 'DOI'@en ;
        

            skos:definition 'Digital Object Identifier - Lien permanent ou persistant attribué à une ressource numérique, généralement géré par des agences DOI comme CrossRef ou DataCite, pour en faciliter la localisation et la citation.'@fr, 'Digital Object Identifier - Permanent or persistent link assigned to a digital resource, usually managed by DOI agencies such as CrossRef or DataCite, to facilitate its location and citation.'@en ;
        

        dcterms:identifier 'FDS1444' .
    

        tfo:FDS1570 rdf:type owl:NamedIndividual, tfo:DatasetPIDSchema ;
            skos:prefLabel 'Handle'@fr , 'Handle'@en ;
            dc:title 'Handle'@fr , 'Handle'@en ;
        

            skos:definition 'Identifiant persistant attribué àune ressource numérique, géré par le Handle System (CNRI).'@fr, 'Persistent identifier assigned to a digital resource, managed by the Handle System (CNRI).'@en ;
        

        dcterms:identifier 'FDS1570' .
    

        tfo:FDS6835 rdf:type owl:NamedIndividual, tfo:DatasetPIDSchema ;
            skos:prefLabel 'Autre'@fr , 'Other'@en ;
            dc:title 'Autre'@fr , 'Other'@en ;
        

            skos:definition 'À utiliser lorsque le type d\'identifiant est connu, mais introuvable dans la liste.'@fr, 'Used when the identifier type is known but cannot be found in the list.'@en ;
        

        dcterms:identifier 'FDS6835' .
    