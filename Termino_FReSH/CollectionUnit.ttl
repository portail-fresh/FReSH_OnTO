    fresh:terminologies rdf:type owl:Class .


    tfo:CollectionUnit rdf:type owl:Class ;
        rdfs:subClassOf fresh:terminologies ;
        dcterms:identifier term:FCU ;
        dcterms:title 'Unité de collecte'@fr , 'Collection unit'@en ;
        dcterms:description 'Concepts utilisés pour décrire le champ CollectionUnit du schéma de métadonnées FReSH.'@fr , 'Terms used to describe the field CollectionUnit in the FReSH metadata schema.'@en ;
