    fresh:terminologies rdf:type owl:Class .


    tfo:DocumentType rdf:type owl:Class ;
        rdfs:subClassOf fresh:terminologies ;
        dcterms:identifier term:FDT ;
        dcterms:title 'Type de document'@fr , 'Document Type'@en ;
        dcterms:description 'Concepts utilisés pour décrire le champ DocumentType du schéma de métadonnées FReSH.'@fr , 'Terms used to describe the field DocumentType in the FReSH metadata schema.'@en ;
        dcterms:creator fresh: ;
        pav:createdOn "2026-01-05"^^xsd:date ;
        pav:lastUpdatedOn '2026-04-07' ;


    
 
        fresh:metadataConcerned 'DocumentType';


        
 
        dcterms:license 'https://creativecommons.org/licenses/by-nc-sa/4.0/' .


            
        tfo:FDT4538 rdf:type owl:NamedIndividual, tfo:DocumentType ;
            skos:prefLabel 'Publication définissant la base de données et/ou son protocole de collecte (article présentant les données, profil de la cohorte, article sur la méthode ou le protocole, article de synthèse, note sur les données, rapport enregistré...).'@fr , 'Publication defining the database and/or its collection protocol  (data paper, cohort profile, method/protocol paper, resource paper, data note, registered report...).'@en ;
            dc:title 'Publication définissant la base de données et/ou son protocole de collecte (article présentant les données, profil de la cohorte, article sur la méthode ou le protocole, article de synthèse, note sur les données, rapport enregistré...).'@fr , 'Publication defining the database and/or its collection protocol  (data paper, cohort profile, method/protocol paper, resource paper, data note, registered report...).'@en ;
        

        dcterms:identifier 'FDT4538' .
    

        tfo:FDT6087 rdf:type owl:NamedIndividual, tfo:DocumentType ;
            skos:prefLabel 'Publication issue de l\'étude et présentant les résultats de la recherche (articles, posters, rapports, ouvrages ou chapitres...).'@fr , 'Publication resulting from the study and presenting research findings (articles, posters, reports, books or chapters, etc.).'@en ;
            dc:title 'Publication issue de l\'étude et présentant les résultats de la recherche (articles, posters, rapports, ouvrages ou chapitres...).'@fr , 'Publication resulting from the study and presenting research findings (articles, posters, reports, books or chapters, etc.).'@en ;
        

        dcterms:identifier 'FDT6087' .
    

        tfo:FDT6755 rdf:type owl:NamedIndividual, tfo:DocumentType ;
            skos:prefLabel 'Publication réutilisant les données collectées dans le cadre de cette étude.'@fr , 'Publication reusing data collected in this study.'@en ;
            dc:title 'Publication réutilisant les données collectées dans le cadre de cette étude.'@fr , 'Publication reusing data collected in this study.'@en ;
        

        dcterms:identifier 'FDT6755' .
    

        tfo:FDT6296 rdf:type owl:NamedIndividual, tfo:DocumentType ;
            skos:prefLabel 'Protocole de l\'étude.'@fr , 'Study protocol.'@en ;
            dc:title 'Protocole de l\'étude.'@fr , 'Study protocol.'@en ;
        

        dcterms:identifier 'FDT6296' .
    