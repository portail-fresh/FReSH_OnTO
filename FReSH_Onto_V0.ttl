@prefix : <https://purl.org/fresh/FReSH_OnTO#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix eur: <http://data.europa.eu/8mn/euroscivoc/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix pav: <http://purl.org/pav/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix tfo: <https://purl.org/fresh/Termino_FReSH_OnTO#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix mesh: <http://id.nlm.nih.gov/mesh/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix term: <https://purl.org/fresh/terminologies/> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix fresh: <https://purl.org/fresh/FReSH_OnTO#> .
@prefix vocab: <https://portail-fresh.fr/vocab/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@base <https://purl.org/fresh/FReSH_OnTO#> .

<https://purl.org/fresh/FReSH_OnTO> rdf:type owl:Ontology ;
                                     owl:versionIRI <https://purl.org/fresh/FReSH_OnTO/1.0.0> ;
                                     owl:imports <http://protege.stanford.edu/plugins/owl/dc/protege-dc.owl> ,
                                                 <https://purl.org/fresh/Termino_FReSH_OnTO> ;
                                     dcterms:contributor "andrea.blivet" ;
                                     dcterms:created "2026-07-24"^^xsd:date ;
                                     dcterms:creator <https://purl.org/fresh/> ;
                                     dcterms:description "Représentation ontologique du schéma de métadonnées FReSH"@fr ;
                                     dcterms:license <https://creativecommons.org/licenses/by-nc-sa/4.0/> ;
                                     dcterms:title "FReSH_OnTO" ;
                                     vann:preferredNamespacePrefix "fresh" ;
                                     <http://schema.org/image> "https://raw.githubusercontent.com/portail-fresh/technical-documentation/refs/heads/main/site/assets/logocouleur.jpg" .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/contributor
dcterms:contributor rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/created
dcterms:created rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/creator
dcterms:creator rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/description
dcterms:description rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/identifier
dcterms:identifier rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/license
dcterms:license rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/title
dcterms:title rdf:type owl:AnnotationProperty .


###  http://purl.org/pav/createdOn
pav:createdOn rdf:type owl:AnnotationProperty .


###  http://purl.org/pav/lastUpdatedOn
pav:lastUpdatedOn rdf:type owl:AnnotationProperty .


###  http://purl.org/vocab/vann/preferredNamespacePrefix
vann:preferredNamespacePrefix rdf:type owl:AnnotationProperty .


###  http://schema.org/image
<http://schema.org/image> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#broadMatch
skos:broadMatch rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#closeMatch
skos:closeMatch rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#definition
skos:definition rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#exactMatch
skos:exactMatch rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#narrowMatch
skos:narrowMatch rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#prefLabel
skos:prefLabel rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#relatedMatch
skos:relatedMatch rdf:type owl:AnnotationProperty .


###  http://xmlns.com/foaf/0.1/logo
<http://xmlns.com/foaf/0.1/logo> rdf:type owl:AnnotationProperty .


###  https://purl.org/fresh/metadataConcerned
<https://purl.org/fresh/metadataConcerned> rdf:type owl:AnnotationProperty .


#################################################################
#    Datatypes
#################################################################

###  https://purl.org/fresh/FReSH_OnTO#section
fresh:section rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  https://purl.org/fresh/FReSH_OnTO#hasValue
fresh:hasValue rdf:type owl:ObjectProperty .


#################################################################
#    Data properties
#################################################################

###  https://purl.org/fresh/FReSH_OnTO#hasDatatype
fresh:hasDatatype rdf:type owl:DatatypeProperty .


#################################################################
#    Classes
#################################################################

###  https://purl.org/fresh/FReSH_OnTO#AccessConditions
fresh:AccessConditions rdf:type owl:Class ;
                       rdfs:subClassOf fresh:UseStatement ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty fresh:hasDatatype ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onDataRange xsd:string
                                       ] ;
                       dc:description "Any additional information that will assist the user in understanding the access and use conditions of the data collection (for example, contact the principal investigator for more information)."@en ,
                                      "Toute information supplémentaire susceptible d'aider l'utilisateur à comprendre les conditions d'accès et d'utilisation de la collecte de données (par exemple, contacter l'investigateur principal pour plus d'information)"@fr ;
                       dc:identifier "E-129"^^xsd:anyURI ;
                       dc:title "Conditions d'accès aux données"@fr ,
                                "Data access conditions"@en .


###  https://purl.org/fresh/FReSH_OnTO#AccessRestrictions
fresh:AccessRestrictions rdf:type owl:Class ;
                         rdfs:subClassOf fresh:UseStatement ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty fresh:hasDatatype ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onDataRange xsd:string
                                         ] ;
                         dc:description "Any restrictions on access to or use of the data collection such as privacy certification or distribution restrictions should be indicated here. These can be restrictions applied by the author, producer, or disseminator of the data. "@en ,
                                        "Toute restriction relative à l'accès ou à l'utilisation du recueil de données, telle que la certification de confidentialité ou les restrictions de distribution, doit être indiquée ici. Il peut s'agir de restrictions appliquées par l'auteur, le producteur ou le diffuseur des données."@fr ;
                         dc:identifier "E-130"^^xsd:anyURI ;
                         dc:title "Access restrictions"@en ,
                                  "Restrictions d'accès"@fr .


###  https://purl.org/fresh/FReSH_OnTO#Acronym
fresh:Acronym rdf:type owl:Class ;
              rdfs:subClassOf fresh:StudyOverview ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty fresh:hasDatatype ;
                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                owl:onDataRange xsd:string
                              ] ;
              dc:identifier "E-017"^^xsd:anyURI ;
              dc:title "Acronyme de l'étude"@fr ,
                       "Study acronym"@en .


###  https://purl.org/fresh/FReSH_OnTO#ActiveFollowUp
fresh:ActiveFollowUp rdf:type owl:Class ;
                     rdfs:subClassOf fresh:DataCollection ;
                     dc:description "Active follow-up refers to a systematic process of collecting information from participants after their inclusion in the study, initiated by the research team. It involves direct or organised contact (through visits, phone calls, questionnaires, examinations, etc.) to regularly obtain data on health status, exposures, or events occurring during the observation period."@en ,
                                    "Le suivi actif désigne une procédure systématique de collecte d’informations auprès des participants après leur inclusion dans l’étude, à l’initiative de l’équipe de recherche. Il implique un contact direct ou organisé (par visite, appel, questionnaire, examen, etc.) visant à recueillir régulièrement des données sur l’état de santé, l’exposition, ou les événements survenus pendant la période d’observation."@fr ;
                     dc:identifier "S-044"^^xsd:anyURI ;
                     dc:title "Active follow-up"@en ,
                              "Suivi actif des participants"@fr .


###  https://purl.org/fresh/FReSH_OnTO#AddTeamMember
fresh:AddTeamMember rdf:type owl:Class ;
                    rdfs:subClassOf fresh:AdministrativeInformation ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty fresh:hasDatatype ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onDataRange xsd:boolean
                                    ] ;
                    dc:identifier "E-196"^^xsd:anyURI ;
                    dc:title "Are other teams involved in this study?"@en ,
                             "D'autres équipes sont-elles impliquées dans cette étude ? "@fr .


###  https://purl.org/fresh/FReSH_OnTO#AdditionalDataAccessLink
fresh:AdditionalDataAccessLink rdf:type owl:Class ;
                               rdfs:subClassOf fresh:UseStatement ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty fresh:hasDatatype ;
                                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                 owl:onDataRange xsd:string
                                               ] ;
                               dc:description "Indique une URL ou une référence pointant vers le plan de partage ou vers une page ou un document décrivant plus en détail les conditions et procédures d’accès aux données."@fr ,
                                              "Provides a URL or reference to a sharing plan or to a page or document that describes in more detail the conditions and procedures for accessing the data."@en ;
                               dc:identifier "E-131"^^xsd:anyURI ;
                               dc:title "Lien vers le plan de partage des données ou vers une documentation relative à l'accès aux données"@fr ,
                                        "Link to sharing plan or to documentation relating to data access."@en .


###  https://purl.org/fresh/FReSH_OnTO#AdministrativeInformation
fresh:AdministrativeInformation rdf:type owl:Class ;
                                rdfs:subClassOf fresh:FreshSchema ;
                                dc:identifier "S-006"^^xsd:anyURI ;
                                dc:title "Administrative information"@en ,
                                         "Renseignements administratifs"@fr .


###  https://purl.org/fresh/FReSH_OnTO#Age
fresh:Age rdf:type owl:Class ;
          rdfs:subClassOf fresh:DemographicInfo ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty fresh:hasValue ;
                            owl:someValuesFrom tfo:Age
                          ] ;
          dc:description "A type of eligibility criteria that indicates the age groupe of a person to participate in a study."@en ,
                         "Un type de critère d'éligibilité qui indique la tranche d'âge d'une personne pouvant participer à une étude."@fr ;
          dc:identifier "E-109"^^xsd:anyURI ;
          dc:title "Age"@en ,
                   "Age"@fr .


###  https://purl.org/fresh/FReSH_OnTO#AggregatedDataAccess
fresh:AggregatedDataAccess rdf:type owl:Class ;
                           rdfs:subClassOf fresh:DataAvailability ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty fresh:hasDatatype ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onDataRange xsd:string
                                           ] ;
                           dc:identifier "E-126"^^xsd:anyURI ;
                           dc:title "Conditions under which the aggregated data are made available"@en ,
                                    "Modalités de mise à disposition des données agrégées"@fr .


###  https://purl.org/fresh/FReSH_OnTO#Allocation
fresh:Allocation rdf:type owl:Class ;
                 rdfs:subClassOf fresh:InterventionalStudy ;
                 dc:description "A method used to assign participants to an an intervention group or arm of a clinical study. "@en ,
                                "Méthode utilisée pour affecter les participants à un groupe d'intervention ou à un bras d'une étude clinique."@fr ;
                 dc:identifier "S-030"^^xsd:anyURI ;
                 dc:title "Allocation "@en ,
                          "Allocation "@fr .


###  https://purl.org/fresh/FReSH_OnTO#AllocationMode
fresh:AllocationMode rdf:type owl:Class ;
                     rdfs:subClassOf fresh:Allocation ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty fresh:hasValue ;
                                       owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass tfo:AllocationMode
                                     ] ;
                     dc:description "Les modes d'allocation sont l'allocation randomisée et l'allocation non randomisée. "@fr ,
                                    "The types of allocation are randomized allocation and nonrandomized."@en ;
                     dc:identifier "E-066"^^xsd:anyURI ;
                     dc:title "Allocation type"@en ,
                              "Mode d'allocation"@fr .


###  https://purl.org/fresh/FReSH_OnTO#AllocationUnit
fresh:AllocationUnit rdf:type owl:Class ;
                     rdfs:subClassOf fresh:Allocation ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty fresh:hasValue ;
                                       owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass tfo:AllocationUnit
                                     ] ;
                     dc:description "Entity to which the intervention is assigned (individual or cluster)."@en ,
                                    "Entité à laquelle l'intervention est attribuée (individuelle ou cluster)."@fr ;
                     dc:identifier "E-067"^^xsd:anyURI ;
                     dc:title "Allocation unit"@en ,
                              "Unité d'allocation"@fr .


###  https://purl.org/fresh/FReSH_OnTO#AnalysisUnit
fresh:AnalysisUnit rdf:type owl:Class ;
                   rdfs:subClassOf fresh:StudyMethodology ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty fresh:hasValue ;
                                     owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onClass tfo:CollectionUnit
                                   ] ;
                   dc:description "Describes the entity being analysed in the study or variable"@en ,
                                  "Décrit l'entité analysée dans l'étude ou la variable."@fr ;
                   dc:identifier "E-061"^^xsd:anyURI ;
                   dc:title "Collection unit"@en ,
                            "Unité de collecte"@fr .


###  https://purl.org/fresh/FReSH_OnTO#Arm
fresh:Arm rdf:type owl:Class ;
          rdfs:subClassOf fresh:InterventionalStudy ;
          dc:description "Sous-groupe de participants dans une étude interventionnelle. Chaque bras reçoit une intervention spécifique ou suit une stratégie particulière, permettant de comparer les effets entre bras."@fr ,
                         "Subgroup of participants in an interventional study. Each arm receives a specific intervention or follows a particular strategy, allowing comparison of effects across arms."@en ;
          dc:identifier "S-033"^^xsd:anyURI ;
          dc:title "Arm (or subgroup of participants)"@en ,
                   "Bras (ou sous-groupe de participants)"@fr .


###  https://purl.org/fresh/FReSH_OnTO#ArmDescription
fresh:ArmDescription rdf:type owl:Class ;
                     rdfs:subClassOf fresh:Arm ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty fresh:hasDatatype ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onDataRange xsd:string
                                     ] ;
                     dc:description "Brief description of the arm, including its purpose or characteristics."@en ,
                                    "Brève description du bras, y compris son objectif ou ses caractéristiques."@fr ;
                     dc:identifier "E-074"^^xsd:anyURI ;
                     dc:title "Arm description"@en ,
                              "Description du bras"@fr .


###  https://purl.org/fresh/FReSH_OnTO#ArmName
fresh:ArmName rdf:type owl:Class ;
              rdfs:subClassOf fresh:Arm ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty fresh:hasDatatype ;
                                owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                owl:onDataRange xsd:string
                              ] ;
              dc:description "Le libellé choisi pour le bras, unique dans le cadre de l'étude"@fr ,
                             "The title chosen for the arm, unique within the study"@en ;
              dc:identifier "E-071"^^xsd:anyURI ;
              dc:title "Arm name"@en ,
                       "Nom du bras"@fr .


###  https://purl.org/fresh/FReSH_OnTO#ArmType
fresh:ArmType rdf:type owl:Class ;
              rdfs:subClassOf fresh:Arm ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty fresh:hasValue ;
                                owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                owl:onClass tfo:ArmType
                              ] ;
              dc:description "A general description of the study arm. It identifies the role of the intervention that participants receive. Types of arms include experimental arm, active comparator arm, placebo comparator arm, sham comparator arm, and no intervention arm."@en ,
                             "Description générale du bras participant à l'étude. Elle identifie le rôle de l'intervention dont bénéficient les participants. Les types de bras comprennent le bras expérimental, comparateur actif, comparateur placebo, comparateur fictif et le bras sans intervention."@fr ;
              dc:identifier "E-072"^^xsd:anyURI ;
              dc:title "Arm type"@en ,
                       "Type de bras"@fr .


###  https://purl.org/fresh/FReSH_OnTO#ArmTypeOther
fresh:ArmTypeOther rdf:type owl:Class ;
                   rdfs:subClassOf fresh:Arm ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty fresh:hasDatatype ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onDataRange xsd:string
                                   ] ;
                   dc:description "Specifies the arm type if “Other” was selected above."@en ,
                                  "Spécifie le type de bras si « Autre » a été sélectionné ci-dessus."@fr ;
                   dc:identifier "E-073"^^xsd:anyURI ;
                   dc:title "Autre type de bras, précisions"@fr ,
                            "Other arm type, details"@en .


###  https://purl.org/fresh/FReSH_OnTO#AuthorizingAgency
fresh:AuthorizingAgency rdf:type owl:Class ;
                        rdfs:subClassOf fresh:ObtainedAuthorization ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty fresh:hasValue ;
                                          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onClass tfo:AutorisationAgency
                                        ] ;
                        dc:identifier "E-018"^^xsd:anyURI ;
                        dc:title "Autorité compétente ayant délivré l'autorisation ou l'avis de validité de l'étude"@fr ,
                                 "Competent authority that issued the authorisation or notice of validity for the study"@en .


###  https://purl.org/fresh/FReSH_OnTO#AutoTranslation
fresh:AutoTranslation rdf:type owl:Class ;
                      rdfs:subClassOf fresh:TechnicalInfo ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty fresh:hasDatatype ;
                                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:boolean
                                      ] ;
                      dc:description "Indicates whether the record has been automatically translated"@en ,
                                     "Indique si la fiche a été traduite automatiquement"@fr ;
                      dc:identifier "E-010"^^xsd:anyURI ;
                      dc:title "Automatic translation"@en ,
                               "Traduction automatique"@fr .


###  https://purl.org/fresh/FReSH_OnTO#BiobankContent
fresh:BiobankContent rdf:type owl:Class ;
                     rdfs:subClassOf fresh:DataTypes ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty fresh:hasValue ;
                                       owl:someValuesFrom tfo:BiobankContent
                                     ] ;
                     dc:description "Selection, from a predefined list, of the type(s) of samples contained in the biobank"@en ,
                                    "Sélection, à partir d’une liste prédéfinie, du ou des types d'échantillons contenus dans la biobanque"@fr ;
                     dc:identifier "E-123"^^xsd:anyURI ;
                     dc:title "Nature des échantillons"@fr ,
                              "Nature of samples"@en .


###  https://purl.org/fresh/FReSH_OnTO#BiobankContentOther
fresh:BiobankContentOther rdf:type owl:Class ;
                          rdfs:subClassOf fresh:DataTypes ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty fresh:hasDatatype ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onDataRange xsd:string
                                          ] ;
                          dc:identifier "E-155"^^xsd:anyURI ;
                          dc:title "Autre échantillon, précisions"@fr ,
                                   "Other sample, details"@en .


###  https://purl.org/fresh/FReSH_OnTO#BiologicalDataDetails
fresh:BiologicalDataDetails rdf:type owl:Class ;
                            rdfs:subClassOf fresh:DataTypes ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty fresh:hasDatatype ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onDataRange xsd:string
                                            ] ;
                            dc:description "Details regarding the biological data collected"@en ,
                                           "Précisions concernant les données biologiques collectées"@fr ;
                            dc:identifier "E-121"^^xsd:anyURI ;
                            dc:title "Biological data, details"@en ,
                                     "Données biologiques, précisions"@fr .


###  https://purl.org/fresh/FReSH_OnTO#BlindedMaskingDetails
fresh:BlindedMaskingDetails rdf:type owl:Class ;
                            rdfs:subClassOf fresh:Masking ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty fresh:hasValue ;
                                              owl:someValuesFrom tfo:BlindedMaskingDetails
                                            ] ;
                            dc:description "Précise quels acteurs de l’étude (participant, personnel soignant, investigateur, analyste des données) ignorent l’intervention attribuée, afin de limiter les biais."@fr ,
                                           "Specifies which stakeholders in the study (participant, care provider, investigator, outcome assessor ) are unaware of the assigned intervention, in order to reduce bias."@en ;
                            dc:identifier "E-069"^^xsd:anyURI ;
                            dc:title "Blinded masking group(s)"@en ,
                                     "Groupe(s) avec insu (en aveugle)"@fr .


###  https://purl.org/fresh/FReSH_OnTO#ClinicalDataDetails
fresh:ClinicalDataDetails rdf:type owl:Class ;
                          rdfs:subClassOf fresh:DataTypes ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty fresh:hasDatatype ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onDataRange xsd:string
                                          ] ;
                          dc:description "Details regarding the clinical data collected"@en ,
                                         "Précisions concernant les données cliniques collectées"@fr ;
                          dc:identifier "E-120"^^xsd:anyURI ;
                          dc:title "Clinical data, details"@en ,
                                   "Données cliniques, précisions"@fr .


###  https://purl.org/fresh/FReSH_OnTO#Collaborations
fresh:Collaborations rdf:type owl:Class ;
                     rdfs:subClassOf fresh:OrganisationGovernance ;
                     dc:description "Section describing the collaborations involved"@en ,
                                    "Section qui décrit les collaborations impliquées"@fr ;
                     dc:identifier "S-027"^^xsd:anyURI ;
                     dc:title "Collaborations"@en ,
                              "Collaborations"@fr .


###  https://purl.org/fresh/FReSH_OnTO#CollaborationsDetails
fresh:CollaborationsDetails rdf:type owl:Class ;
                            rdfs:subClassOf fresh:Collaborations ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty fresh:hasDatatype ;
                                              owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onDataRange xsd:string
                                            ] ;
                            dc:description "Details on the collaborations involved"@en ,
                                           "Précisions sur les collaborations impliquées"@fr ;
                            dc:identifier "E-050"^^xsd:anyURI ;
                            dc:title "Collaboration(s) impliquée(s), précisions"@fr ,
                                     "Collaboration(s) involved, details"@en .


###  https://purl.org/fresh/FReSH_OnTO#CollectionChronology
fresh:CollectionChronology rdf:type owl:Class ;
                           rdfs:subClassOf fresh:DataCollectionIntegration ;
                           dc:description "Indicates the period during which the study data were collected."@en ,
                                          "Indique la période pendant laquelle les données de l’étude ont été recueillies."@fr ;
                           dc:identifier "S-043"^^xsd:anyURI ;
                           dc:title "Chronologie de la collecte"@fr ,
                                    "Collection chronology"@en .


###  https://purl.org/fresh/FReSH_OnTO#CollectionEnd
fresh:CollectionEnd rdf:type owl:Class ;
                    rdfs:subClassOf fresh:CollectionChronology ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty fresh:hasValue ;
                                      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onClass tfo:nan
                                    ] ;
                    dc:description "la date à laquelle la collecte des données individuelles a été terminée dans le cadre de l’étude"@fr ,
                                   "the date on which the collection of individual data was completed as part of the study"@en ;
                    dc:identifier "E-097"^^xsd:anyURI ;
                    dc:title "Collection end date (last follow-up of the last participant)"@en ,
                             "Date de fin de la collecte (dernier suivi du dernier participant)"@fr .


###  https://purl.org/fresh/FReSH_OnTO#CollectionFrequency
fresh:CollectionFrequency rdf:type owl:Class ;
                          rdfs:subClassOf fresh:CollectionChronology ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty fresh:hasDatatype ;
                                            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onDataRange xsd:string
                                          ] ;
                          dc:description "Intervalles ou nombre de mesures réalisées au cours de l’étude"@fr ,
