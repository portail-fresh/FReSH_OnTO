    fresh:terminologies rdf:type owl:Class .


    tfo:Provenance rdf:type owl:Class ;
        rdfs:subClassOf fresh:terminologies ;
        dcterms:identifier term:FPV ;
        dcterms:title 'Provenance de l\'étude'@fr , 'Study provenance'@en ;
        dcterms:description 'Concepts utilisés pour décrire le champ Provenance du schéma de métadonnées FReSH.'@fr , 'Terms used to describe the field Provenance in the FReSH metadata schema.'@en ;
        dcterms:creator fresh: ;
        pav:createdOn "2026-01-05"^^xsd:date ;
        pav:lastUpdatedOn '2026-04-07' ;


    
 
        fresh:metadataConcerned 'Provenance';


        
 
        dcterms:license 'https://creativecommons.org/licenses/by-nc-sa/4.0/' .


            
        tfo:FPV4669 rdf:type owl:NamedIndividual, tfo:Provenance ;
            skos:prefLabel 'PEF (Portail Epidémiologie France)'@fr , 'PEF (Epidemiology France Portal)'@en ;
            dc:title 'PEF (Portail Epidémiologie France)'@fr , 'PEF (Epidemiology France Portal)'@en ;
        

            skos:definition 'Catalogue des bases de données individuelles en santé en France (https://epidemiologie-france.aviesan.fr/).'@fr, 'Catalogue of the individual health databases in France (https://epidemiologie-france.aviesan.fr/en).'@en ;
        

        dcterms:identifier 'FPV4669' .
    

        tfo:FPV4434 rdf:type owl:NamedIndividual, tfo:Provenance ;
            skos:prefLabel 'Clinical Trials'@fr , 'Clinical Trials'@en ;
            dc:title 'Clinical Trials'@fr , 'Clinical Trials'@en ;
        

            skos:definition 'Site web et base de données en ligne consacrés aux études cliniques et aux informations relatives à leurs résultats.  (https://clinicaltrials.gov/)'@fr, 'Website and online database of clinical research studies and information about their results (https://clinicaltrials.gov/).'@en ;
        

        dcterms:identifier 'FPV4434' .
    

        tfo:FPV1809 rdf:type owl:NamedIndividual, tfo:Provenance ;
            skos:prefLabel 'FReSH (France Recherche en Santé Humaine)'@fr , 'FReSH (France Recherche en Santé Humaine)'@en ;
            dc:title 'FReSH (France Recherche en Santé Humaine)'@fr , 'FReSH (France Recherche en Santé Humaine)'@en ;
        

            skos:definition 'Portail recensant les collectes de données individuelles relatives à la santé réalisées dans le cadre de la recherche française. '@fr, 'Portal listing individual health data collections carried out as part of French research. '@en ;
        

        dcterms:identifier 'FPV1809' .
    