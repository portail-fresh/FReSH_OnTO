@prefix dcterms: <http://purl.org/dc/terms/> .
    @prefix dc: <http://purl.org/dc/elements/1.1/> .
    @prefix eur: <http://data.europa.eu/8mn/euroscivoc/> .
    @prefix fresh: <https://purl.org/fresh/FReSH_OnTO#> .
    @prefix term: <https://purl.org/fresh/terminologies/> .
    @prefix mesh: <http://id.nlm.nih.gov/mesh/> .
    @prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
    @prefix skos: <http://www.w3.org/2004/02/skos/core#> .
    @prefix vocab: <https://portail-fresh.fr/vocab/> .
    @prefix owl: <http://www.w3.org/2002/07/owl#> .
    @prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
    @prefix pav: <http://purl.org/pav/> .
    @prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
    @prefix tfo: <https://purl.org/fresh/Termino_FReSH_OnTO#> .

    fresh:terminologies rdf:type owl:Class .


    tfo:SourcePurpose rdf:type owl:Class ;
        rdfs:subClassOf fresh:terminologies ;
        dcterms:identifier term:FSP ;
        dcterms:title 'Objectif de l\'intégration de la source'@fr , 'Purpose of using the source in the study'@en ;
        dcterms:description 'Concepts utilisés pour décrire le champ SourcePurpose du schéma de métadonnées FReSH.'@fr , 'Terms used to describe the field SourcePurpose in the FReSH metadata schema.'@en ;
        dcterms:creator fresh: ;
        pav:createdOn "2026-01-05"^^xsd:date ;
        pav:lastUpdatedOn '2026-04-07' ;


    
 
        fresh:metadataConcerned 'SourcePurpose';


        
 
        dcterms:license 'https://creativecommons.org/licenses/by-nc-sa/4.0/' .


            
        tfo:FSP1575 rdf:type owl:NamedIndividual, tfo:SourcePurpose ;
            skos:prefLabel 'Ajout d\'individus'@fr , 'Adding individuals'@en ;
            dc:title 'Ajout d\'individus'@fr , 'Adding individuals'@en ;
        

            skos:definition 'Intégration dans la base d’étude de nouveaux participants identifiés à partir de sources tierces, à des fins d’élargissement d’un échantillon.'@fr, 'Integration into the study database of new participants identified from third-party sources, for the purpose of expanding the sample.'@en ;
        

        dcterms:identifier 'FSP1575' .
    

        tfo:FSP6894 rdf:type owl:NamedIndividual, tfo:SourcePurpose ;
            skos:prefLabel 'Enrichissement des données par croisement (autre que le suivi passif)'@fr , 'Data enrichment through cross-referencing'@en ;
            dc:title 'Enrichissement des données par croisement (autre que le suivi passif)'@fr , 'Data enrichment through cross-referencing'@en ;
        

            skos:definition 'Appariement des données collectées dans le cadre de l’étude avec des données issues de sources externes, dans le but de compléter ou d’élargir l’information disponible sur les participants. Ces sources peuvent inclure des bases médico-administratives, des données socio-économiques, environnementales, biologiques, etc.'@fr, 'Matching data collected as part of the study with data from external sources, with the aim of supplementing or expanding the information available on participants. These sources may include medical-administrative databases, socio-economic, environmental and biological data, etc.'@en ;
        

        dcterms:identifier 'FSP6894' .
    

        tfo:FSP6189 rdf:type owl:NamedIndividual, tfo:SourcePurpose ;
            skos:prefLabel 'Suivi passif des participants'@fr , 'Passive participant monitoring'@en ;
            dc:title 'Suivi passif des participants'@fr , 'Passive participant monitoring'@en ;
        

            skos:definition 'Utilisation continue ou périodique, à des fins de suivi longitudinal, de données de sources tierces pour documenter l’évolution de la situation des participants (statut vital, évenements de santé,etc.) sans contact direct avec eux.'@fr, 'Continuous or periodic use, for longitudinal monitoring purposes, of data from third-party sources to document changes in participants\' circumstances (vital status, health events, etc.) without direct contact with them.'@en ;
        

        dcterms:identifier 'FSP6189' .
    