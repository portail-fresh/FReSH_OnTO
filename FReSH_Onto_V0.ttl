                       rdfs:subClassOf fresh:DataAccess ;
                       dc:identifier "S-067"^^xsd:anyURI ;
                       dc:title "Data availability"@en ,
                                "Disponibilité du jeu de données"@fr .


###  https://purl.org/fresh/FReSH_OnTO#DataCitation
fresh:DataCitation rdf:type owl:Class ;
                   rdfs:subClassOf fresh:DataAccess ;
                   dc:description "Indicates the user's responsibilities with regard to data"@en ,
                                  "Indique les responsabilités de l’utilisateur vis-à-vis des données"@fr ;
                   dc:identifier "S-055"^^xsd:anyURI ;
                   dc:title "Obligations liées à l’usage des données"@fr ,
                            "Obligations related to data use"@en .


###  https://purl.org/fresh/FReSH_OnTO#DataCitationRequirement
fresh:DataCitationRequirement rdf:type owl:Class ;
                              rdfs:subClassOf fresh:DataCitation ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty fresh:hasDatatype ;
                                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                owl:onDataRange xsd:string
                                              ] ;
                              dc:description "Indicates the obligation for users to inform the data producer and distributor of any use of the data, providing references to publications or copies of papers based on this data."@en ,
                                             "Indique l’obligation pour les utilisateurs d’informer le producteur et le distibuteur des données de toute utilisation des données, en fournissant les références des publications ou des copies des papiers s’appuyant sur ces données."@fr ;
                              dc:identifier "E-132"^^xsd:anyURI ;
                              dc:title "Obligation de transmission des travaux "@fr ,
                                       "Reporting requirement"@en .


###  https://purl.org/fresh/FReSH_OnTO#DataCitationStatement
fresh:DataCitationStatement rdf:type owl:Class ;
                            rdfs:subClassOf fresh:DataCitation ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty fresh:hasDatatype ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onDataRange xsd:string
                                            ] ;
                            dc:description "Exigence selon laquelle un recueil de données doit être correctement cité dans les articles ou autres publications basés sur l'analyse de ces données."@fr ,
                                           "Requirement that a data collection should be cited properly in articles or other publications that are based on analysis of the data."@en ;
                            dc:identifier "E-133"^^xsd:anyURI ;
                            dc:title "Citation requirement"@en ,
                                     "Obligation de citation"@fr .


###  https://purl.org/fresh/FReSH_OnTO#DataCollection
fresh:DataCollection rdf:type owl:Class ;
                     rdfs:subClassOf fresh:DataCollectionIntegration ;
                     dc:description "All information collected directly from study participants during the course of the study, through observation, measurement, examination, sampling, interview, questionnaire, or follow-up."@en ,
                                    "Ensemble des informations recueillies directement auprès des participants au cours de l’étude, que ce soit par observation, mesure, examen, prélèvement, entretien, questionnaire ou suivi."@fr ;
                     dc:identifier "S-041"^^xsd:anyURI ;
                     dc:title "Information concerning data collected from participants during the study (Information concerning the reuse of existing data will be provided in the next section)."@en ,
                              "Informations concernant les données collectées auprès des participants dans le cadre de l'étude (Les informations concernant la réutilisation de données existantes seront à renseigner dans la prochaine section)"@fr .


###  https://purl.org/fresh/FReSH_OnTO#DataCollectionAccess
fresh:DataCollectionAccess rdf:type owl:Class ;
                           rdfs:subClassOf fresh:FreshSchema ;
                           dc:identifier "S-074"^^xsd:anyURI ;
                           dc:title "Collecte et accès aux données"@fr ,
                                    "Data collection and access"@en .


###  https://purl.org/fresh/FReSH_OnTO#DataCollectionIntegration
fresh:DataCollectionIntegration rdf:type owl:Class ;
                                rdfs:subClassOf fresh:DataCollectionAccess ;
                                dc:description "Cette section décrit les données utilisées dans l’étude, qu’elles soient collectées spécifiquement pour celle-ci ou réutilisées à partir de sources tierces préexistantes."@fr ,
                                               "This section describes the data used in the study, whether collected specifically for this study or reused from pre-existing third-party sources."@en ;
                                dc:identifier "S-040"^^xsd:anyURI ;
                                dc:title "Collecte et réutilisation de données"@fr ,
                                         "Data collection and reuse"@en .


###  https://purl.org/fresh/FReSH_OnTO#DataFileCompleteness
fresh:DataFileCompleteness rdf:type owl:Class ;
                           rdfs:subClassOf fresh:DataAvailability ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty fresh:hasDatatype ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onDataRange xsd:string
                                           ] ;
                           dc:description "Indicates any discrepancy between the data collected and the data available. It allows you to specify, where applicable, the reasons why certain items collected have not been included in the shared data file (e.g. items that directly identify individuals)."@en ,
                                          "Indique l'écart éventuel entre les données collectées et les données disponibles. Il permet de préciser, le cas échéant, les raisons pour lesquelles certains éléments collectés n’ont pas été inclus dans le fichier de données partagées (par exemple, les éléments directement identifiants)."@fr ;
                           dc:identifier "E-134"^^xsd:anyURI ;
                           dc:title "Complétude des fichiers des données "@fr ,
                                    "Data file completeness "@en .


###  https://purl.org/fresh/FReSH_OnTO#DataInformationContact
fresh:DataInformationContact rdf:type owl:Class ;
                             rdfs:subClassOf fresh:UseStatement ;
                             dc:description "Names and addresses of individuals involved in the study who can be contacted for information about the data. They can be consulted as resource persons for problems or questions raised by users."@en ,
                                            "Noms et adresses des personnes impliquées dans l'étude, à contacter pour obtenir les renseignements concernant les données. Elles peuvent être sollicitées en tant que personnes ressources pour les problèmes ou questions soulevés par les utilisateurs. "@fr ;
                             dc:identifier "S-073"^^xsd:anyURI ;
                             dc:title "Contact person for data information"@en ,
                                      "Personne à contacter pour des renseignements concernant les données"@fr .


###  https://purl.org/fresh/FReSH_OnTO#DataIntegration
fresh:DataIntegration rdf:type owl:Class ;
                      rdfs:subClassOf fresh:DataCollectionIntegration ;
                      dc:description "La réutilisation de données existantes désigne le recours, dans le cadre de l’étude, à des données déjà collectées pour un autre objectif (recherche antérieure, registre, base administrative, dossier médical, etc.), sans nouvelle collecte directe auprès des participants."@fr ,
                                     "The reuse of existing data refers to the use, within the study, of data previously collected for another purpose (such as a prior research project, registry, administrative database, or medical record), without new data collection directly from participants."@en ;
                      dc:identifier "S-066"^^xsd:anyURI ;
                      dc:title "Reuse of existing data"@en ,
                               "Réutilisation de données existantes"@fr .


###  https://purl.org/fresh/FReSH_OnTO#DataLocation
fresh:DataLocation rdf:type owl:Class ;
                   rdfs:subClassOf fresh:DataAvailability ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty fresh:hasDatatype ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onDataRange xsd:string
                                   ] ;
                   dc:description "Emplacement où les données collectées sont actuellement stockées."@fr ,
                                  "Location where the data collection is currently stored. "@en ;
                   dc:identifier "E-136"^^xsd:anyURI ;
                   dc:title "Data location"@en ,
                            "Localisation des données"@fr .


###  https://purl.org/fresh/FReSH_OnTO#DataQuality
fresh:DataQuality rdf:type owl:Class ;
                  rdfs:subClassOf fresh:DataAccess ;
                  dc:description "Information on the procedures and tools implemented to ensure the quality, consistency, and traceability of data collected in the study."@en ,
                                 "Informations sur les procédures et outils mis en place pour assurer la qualité, la cohérence et la traçabilité des données collectées dans l’étude."@fr ;
                  dc:identifier "S-057"^^xsd:anyURI ;
                  dc:title "Data quality"@en ,
                           "Qualité des données"@fr .


###  https://purl.org/fresh/FReSH_OnTO#DataType
fresh:DataType rdf:type owl:Class ;
               rdfs:subClassOf fresh:DataTypes ,
