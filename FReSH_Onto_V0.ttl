###  https://purl.org/fresh/FReSH_OnTO#TrialPhase
fresh:TrialPhase rdf:type owl:Class ;
                 rdfs:subClassOf fresh:InterventionalStudy ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty fresh:hasValue ;
                                   owl:someValuesFrom tfo:TrialPhase
                                 ] ;
                 dc:description "Stade d’un essai clinique définissant les objectifs et méthodes de l’évaluation d’un médicament ou produit biologique (tolérance, efficacité, comparaison, suivi). Pour les essais à phases combinées, cocher plusieurs cases."@fr ,
                                "The stage of a clinical trial defining the objectives and methods of evaluating a drug or biological product (tolerance, efficacy, comparison, follow-up). For combined phases, check several options."@en ;
                 dc:identifier "E-064"^^xsd:anyURI ;
                 dc:title "Phase de l'essai (Pour les essais à phases combinées, cochez plusieurs cases.)"@fr ,
                          "Study Phase (For combined phases, check several options.)"@en .


###  https://purl.org/fresh/FReSH_OnTO#URI
fresh:URI rdf:type owl:Class ;
          rdfs:subClassOf fresh:DatasetPID ,
                          fresh:FundingAgentPID ,
                          fresh:OrganisationPID ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty fresh:hasDatatype ;
                            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                            owl:onDataRange xsd:string
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty fresh:hasDatatype ;
                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                            owl:onDataRange xsd:string
                          ] ;
          dc:description "Code ou référence unique permettant d’identifier et de retrouver le jeu de données. Il peut être attribué par le producteur ou par l’hébergeur des données, ou correspondre à un identifiant persistant international (ex. DOI)."@fr ,
                         "Funder identifier URI"@en ,
                         "Identifiant de l'organisme financeur"@fr ,
                         "Unique code or reference used to identify and locate the dataset. It may be assigned by the data producer or the data host, or correspond to an international persistent identifier (e.g., DOI)."@en ;
          dc:identifier "E-023"^^xsd:anyURI ,
                        "E-146"^^xsd:anyURI ;
          dc:title "Dataset identifier"@en ,
                   "Funder identifier"@en ,
                   "Identifiant de l’organisation d’affiliation principale"@fr ,
                   "Identifiant du financeur"@fr ,
                   "Identifiant du jeu de données"@fr ,
                   "Main affiliated organisation identifier"@en .


