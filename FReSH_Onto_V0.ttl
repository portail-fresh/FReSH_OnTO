                                        owl:onProperty fresh:hasValue ;
                                        owl:someValuesFrom tfo:ResearchPurpose
                                      ] ;
                      dc:description "L'objectif principal de la ou des interventions évaluées dans le cadre de l'étude."@fr ,
                                     "The main objective of the intervention(s) being evaluated by the study."@en ;
