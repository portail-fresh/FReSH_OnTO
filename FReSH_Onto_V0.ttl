                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger;
                                    owl:onDataRange xsd:string];
                            
;                    dc:title "Description du bras"@fr, "Arm description"@en;
                    dc:description "Brève description du bras, y compris son objectif ou ses caractéristiques."@fr, "Brief description of the arm, including its purpose or characteristics."@en.
fresh:Intervention rdf:type owl:Class;
                        dc:identifier "S-039"^^xsd:anyURI;
                        rdfs:subClassOf fresh:InterventionalStudy

;                    dc:title "Facteur, processus ou exposition étudié"@fr, "Studied factor, process, or exposure"@en;
                    dc:description "Tout processus, action ou facteur auquel les participants sont soumis ou exposés, et qui fait l’objet d’une étude observationnelle afin d’évaluer ses effets sur la santé."@fr, "Any process, action or factor to which participants are subjected or exposed, and which is the subject of an observational study to assess its effects on health."@en.
fresh:InterventionName rdf:type owl:Class;
                        dc:identifier "E-082"^^xsd:anyURI;
                        rdfs:subClassOf fresh:Intervention

,
                                    [rdf:type owl:Restriction;
                                    owl:onProperty fresh:hasDatatype;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger;
                                    owl:onDataRange xsd:string];
                            
;                    dc:title "Nom du facteur ou de l'exposition"@fr, "Factor/exposure name"@en;
                    dc:description "Le nom spécifique de l'action, du facteur ou de l'exposition tel qu'il est mentionné dans l'étude. Les facteurs comprennent différents produits de santé ou des approches non invasives, telles que l'éducation ou la modification du régime alimentaire et de l'exercice physique. Les expositions peuvent concerner par exemple des habitudes de vie, des facteurs environnementaux ou des antécédents médicaux."@fr, "The specific name of the action, factor or exposure as it is referred to in the study. Factors include various health products or non-invasive approaches, such as education or changes to diet and exercise. Exposures may include, for example, lifestyle habits, environmental factors, or medical history."@en.
fresh:InterventionType rdf:type owl:Class;
                        dc:identifier "E-083"^^xsd:anyURI;
                        rdfs:subClassOf fresh:Intervention

,
                                    [rdf:type owl:Restriction;
                                    owl:onProperty fresh:hasValue;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger;
                                    owl:onClass tfo:InterventionType];
                            
;                    dc:title "Type de facteur ou d'exposition"@fr, "Factor/exposure type"@en;
                    dc:description "Sélection de la catégorie qui décrit le mieux le facteur ou l'exposition, à partir de la liste prédéfinie d'options."@fr, "Selection of the category that best describes the factor or the exposure from the predefined list of options."@en.
fresh:InterventionTypeOther rdf:type owl:Class;
                        dc:identifier "E-084"^^xsd:anyURI;
                        rdfs:subClassOf fresh:Intervention

