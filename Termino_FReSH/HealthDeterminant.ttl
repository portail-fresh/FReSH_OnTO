    fresh:terminologies rdf:type owl:Class .


    tfo:HealthDeterminant rdf:type owl:Class ;
        rdfs:subClassOf fresh:terminologies ;
        dcterms:identifier term:FHD ;
        dcterms:title 'Déterminants de santé'@fr , 'Health Determinant'@en ;
        dcterms:description 'Concepts utilisés pour décrire le champ HealthDeterminant du schéma de métadonnées FReSH.'@fr , 'Terms used to describe the field HealthDeterminant in the FReSH metadata schema.'@en ;
        dcterms:creator fresh: ;
        pav:createdOn "2026-01-05"^^xsd:date ;
        pav:lastUpdatedOn '2026-04-07' ;


    
 
        fresh:metadataConcerned 'HealthDeterminant';


        
 
