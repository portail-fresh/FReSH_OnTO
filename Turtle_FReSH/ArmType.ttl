@prefix dcterms: <http://purl.org/dc/terms/> .
    @prefix dc: <http://purl.org/dc/elements/1.1/> .
    @prefix eur: <http://data.europa.eu/8mn/euroscivoc/> .
    @prefix fresh: <https://purl.org/fresh/FReSH_OnTO#> .
    @prefix term: <https://purl.org/fresh/terminologies/> .
    @prefix mesh: <http://id.nlm.nih.gov/mesh/> .
    @prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
    @prefix skos: <http://www.w3.org/2004/02/skos/core#> .
    @prefix vocab: <https://portail-fresh.fr/vocab/> .
    @prefix owl: <http://www.w3.org/2002/07/owl#> .
    @prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
    @prefix pav: <http://purl.org/pav/> .
    @prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
    @prefix tfo: <https://purl.org/fresh/Termino_FReSH_OnTO#> .

    fresh:terminologies rdf:type owl:Class .


    tfo:ArmType rdf:type owl:Class ;
        rdfs:subClassOf fresh:terminologies ;
        dcterms:identifier term:FAT ;
        dcterms:title 'Type de bras'@fr , 'Arm type'@en ;
        dcterms:description 'Concepts utilisés pour décrire le champ ArmType du schéma de métadonnées FReSH.'@fr , 'Terms used to describe the field ArmType in the FReSH metadata schema.'@en ;
        dcterms:creator fresh: ;
        pav:createdOn "2026-01-05"^^xsd:date ;
        pav:lastUpdatedOn '2026-04-07' ;


    
 
        fresh:metadataConcerned 'ArmType';


        
 
        dcterms:license 'https://creativecommons.org/licenses/by-nc-sa/4.0/' .


            
        tfo:FAT6332 rdf:type owl:NamedIndividual, tfo:ArmType ;
            skos:prefLabel 'Expérimental'@fr , 'Experimental'@en ;
            dc:title 'Expérimental'@fr , 'Experimental'@en ;
        

            skos:definition 'Bras recevant l\'intervention ou le traitement spécifique.'@fr, 'Arm receiving the specific intervention or treatment.'@en ;
        

        dcterms:identifier 'FAT6332' .
    

        tfo:FAT7155 rdf:type owl:NamedIndividual, tfo:ArmType ;
            skos:prefLabel 'Comparateur actif'@fr , 'Active Comparator'@en ;
            dc:title 'Comparateur actif'@fr , 'Active Comparator'@en ;
        

            skos:definition 'Bras recevant un traitement déjà reconnu, utilisé comme comparaison avec le traitement étudié.'@fr, 'Arm receiving an established treatment, used for comparison with the experimental treatment.'@en ;
        

        dcterms:identifier 'FAT7155' .
    

        tfo:FAT2379 rdf:type owl:NamedIndividual, tfo:ArmType ;
            skos:prefLabel 'Comparateur placebo'@fr , 'Placebo Comparator'@en ;
            dc:title 'Comparateur placebo'@fr , 'Placebo Comparator'@en ;
        

            skos:definition 'Bras recevant une substance inerte (placebo) n’ayant pas d’effet thérapeutique attendu, afin de comparer avec l’intervention étudiée.'@fr, 'Arm receiving an inactive substance (placebo) with no expected therapeutic effect, to compare with the intervention under study.'@en ;
        

        dcterms:identifier 'FAT2379' .
    

        tfo:FAT7054 rdf:type owl:NamedIndividual, tfo:ArmType ;
            skos:prefLabel 'Comparateur fictif'@fr , 'Sham Comparator'@en ;
            dc:title 'Comparateur fictif'@fr , 'Sham Comparator'@en ;
        

            skos:definition 'Bras recevant une procédure ou un dispositif conçu pour être impossible à distinguer de la procédure ou du dispositif réel étudié, mais qui ne contient pas de processus ou de composants actifs, afin de contrôler les effets de la procédure elle-même (durée de l\'opération, anesthésie, implantation du dispositif, etc.).'@fr, 'Arm receiving a procedure or intervention that mimics the real one but without the active/therapeutic component, in order to to control for the effects of the procedure itself (time in surgery, anesthesia, device implantation, etc.).'@en ;
        

        dcterms:identifier 'FAT7054' .
    

        tfo:FAT2443 rdf:type owl:NamedIndividual, tfo:ArmType ;
            skos:prefLabel 'Sans intervention'@fr , 'No intervention'@en ;
            dc:title 'Sans intervention'@fr , 'No intervention'@en ;
        

            skos:definition 'Bras sans intervention.'@fr, 'Arm without intervention.'@en ;
        

        dcterms:identifier 'FAT2443' .
    

        tfo:FAT9716 rdf:type owl:NamedIndividual, tfo:ArmType ;
            skos:prefLabel 'Autre'@fr , 'Other'@en ;
            dc:title 'Autre'@fr , 'Other'@en ;
        

            skos:definition 'À utiliser lorsque le type de bras est connu, mais introuvable dans la liste.'@fr, 'Used when the type of arm is known but cannot be found in the list.'@en ;
        

        dcterms:identifier 'FAT9716' .
    