                                                 owl:onClass tfo:ObservationalStudy
                                               ] ;
                               dc:description "Describes the methodological approach of the observational study, specifying how participants are selected and monitored or observed."@en ,
                                              "Indique l’approche méthodologique de l’étude observationnelle, précisant comment les participants sont sélectionnés et suivis ou observés."@fr ;
                               dc:identifier "E-075"^^xsd:anyURI ;
                               dc:title "Modèle de l’étude observationnelle"@fr ,
                                        "Observational study  design"@en .


