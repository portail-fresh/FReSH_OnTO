;                    dc:title "Autre type de facteur ou d'exposition, précisions"@fr, "Other factor/exposure type, details"@en;
                    dc:description "Spécifie le type du facteur ou d'exposition si « Autre » a été sélectionné ci-dessus."@fr, "Specifies the type of factor or exposure if ‘Other’ was selected above."@en.
fresh:ObservationalStudy rdf:type owl:Class;
                        dc:identifier "S-034"^^xsd:anyURI;
                        rdfs:subClassOf fresh:StudyMethodology

;                    dc:title "Etude observationnelle"@fr, "Observational study"@en;
                    dc:description "Une recherche dans laquelle les investigateurs n’interviennent pas activement sur les participants ou le contexte étudié, mais observent, décrivent et analysent des situations existantes. Elle peut porter sur des données issues de soins courants, d’enquêtes, de registres, d’observations de comportements ou d’environnements, sans introduire de modification volontaire du réel."@fr, "Research in which the investigators do not actively intervene with participants or the study context, but rather observe, describe, and analyze existing situations. It may involve data from routine care, surveys, registries, or observations of behaviors or environments, without introducing any deliberate changes to reality."@en.
fresh:ObservationalStudyDesign rdf:type owl:Class;
                        dc:identifier "E-075"^^xsd:anyURI;
                        rdfs:subClassOf fresh:ObservationalStudy

,
                                    [rdf:type owl:Restriction;
                                    owl:onProperty fresh:hasValue;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger;
                                    owl:onClass tfo:ObservationalStudy];
                            
;                    dc:title "Modèle de l’étude observationnelle"@fr, "Observational study  design"@en;
                    dc:description "Indique l’approche méthodologique de l’étude observationnelle, précisant comment les participants sont sélectionnés et suivis ou observés."@fr, "Describes the methodological approach of the observational study, specifying how participants are selected and monitored or observed."@en.
fresh:OtherResearchTypeDetails rdf:type owl:Class;
                        dc:identifier "E-076"^^xsd:anyURI;
