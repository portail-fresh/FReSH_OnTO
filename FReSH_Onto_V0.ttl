#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/contributor
dcterms:contributor rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/created
dcterms:created rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/creator
dcterms:creator rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/description
dcterms:description rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/identifier
dcterms:identifier rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/license
dcterms:license rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/title
dcterms:title rdf:type owl:AnnotationProperty .


###  http://purl.org/pav/createdOn
pav:createdOn rdf:type owl:AnnotationProperty .


###  http://purl.org/pav/lastUpdatedOn
pav:lastUpdatedOn rdf:type owl:AnnotationProperty .


###  http://purl.org/vocab/vann/preferredNamespacePrefix
<http://purl.org/vocab/vann/preferredNamespacePrefix> rdf:type owl:AnnotationProperty .


###  http://schema.org/image
<http://schema.org/image> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#broadMatch
skos:broadMatch rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#closeMatch
skos:closeMatch rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#definition
skos:definition rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#exactMatch
skos:exactMatch rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#narrowMatch
skos:narrowMatch rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#prefLabel
skos:prefLabel rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#relatedMatch
skos:relatedMatch rdf:type owl:AnnotationProperty .


###  http://xmlns.com/foaf/0.1/logo
<http://xmlns.com/foaf/0.1/logo> rdf:type owl:AnnotationProperty .


###  https://purl.org/fresh/metadataConcerned
<https://purl.org/fresh/metadataConcerned> rdf:type owl:AnnotationProperty .


#################################################################
#    Datatypes
#################################################################

###  https://purl.org/fresh/FReSH_OnTO#section
fresh:section rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  https://purl.org/fresh/FReSH_OnTO#hasValue
fresh:hasValue rdf:type owl:ObjectProperty .


#################################################################
#    Data properties
#################################################################

###  https://purl.org/fresh/FReSH_OnTO#hasDatatype
fresh:hasDatatype rdf:type owl:DatatypeProperty .
fresh:section rdf:type rdfs:Datatype .

fresh:hasValue rdf:type owl:ObjectProperty .

fresh:hasDatatype rdf:type owl:DatatypeProperty .


fresh:TechnicalInfo rdf:type owl:Class;
                        dc:identifier "S-001"^^xsd:anyURI;
                        rdfs:subClassOf fresh:FreshSchema

;                    dc:title "Métadonnées techniques de la fiche"@fr, "Technical metadata "@en.
fresh:StudyID rdf:type owl:Class;
                        dc:identifier "S-002"^^xsd:anyURI;
                        rdfs:subClassOf fresh:TechnicalInfo

;                    dc:title "Identifiant de l'étude"@fr, "Study ID"@en;
                    dc:description "Section contenant l'identifiant  provenant de la source des métadonnées importées"@fr, "Section containing the identifier  from the source of the imported metadata"@en.
fresh:Identifier rdf:type owl:Class;
                        dc:identifier "E-001"^^xsd:anyURI;
                        rdfs:subClassOf fresh:StudyID

,
                                    [rdf:type owl:Restriction;
                                    owl:onProperty fresh:hasDatatype;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger;
                                    owl:onDataRange xsd:string];
                            
;                    dc:title "Code de l'identifiant "@fr, "Study ID code"@en;
                    dc:description "Valeur de l'identifiant"@fr, "Identifier value"@en.
fresh:IDSchema rdf:type owl:Class;
                        dc:identifier "E-002"^^xsd:anyURI;
                        rdfs:subClassOf fresh:StudyID

,
                                    [rdf:type owl:Restriction;
                                    owl:onProperty fresh:hasDatatype;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger;
                                    owl:onDataRange xsd:string];
                            
;                    dc:title "Source de l'identifiant"@fr, "Study ID source"@en;
                    dc:description "Nom de la source "@fr, "Source name "@en.
fresh:Provenance rdf:type owl:Class;
                        dc:identifier "E-003"^^xsd:anyURI;
                        rdfs:subClassOf fresh:TechnicalInfo

,
                                    [rdf:type owl:Restriction;
                                    owl:onProperty fresh:hasValue;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger;
                                    owl:onClass tfo:Provenance];
                            
;                    dc:title "Provenance"@fr, "Provenance"@en;
                    dc:description "Indique la source de provenance des métadonnées"@fr, "Indicates the source of the metadata"@en.
fresh:VersionLang rdf:type owl:Class;
                        dc:identifier "E-004"^^xsd:anyURI;
                        rdfs:subClassOf fresh:TechnicalInfo

,
                                    [rdf:type owl:Restriction;
                                    owl:onProperty fresh:hasValue;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger;
                                    owl:onClass tfo:Language];
                            
;                    dc:title "Langue de la version"@fr, "Version language"@en;
                    dc:description "Langue de la version actuelle de la fiche"@fr, "Language of the current version of the record"@en.
fresh:OriginLang rdf:type owl:Class;
                        dc:identifier "E-005"^^xsd:anyURI;
                        rdfs:subClassOf fresh:TechnicalInfo

,
                                    [rdf:type owl:Restriction;
                                    owl:onProperty fresh:hasValue;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger;
                                    owl:onClass tfo:Language];
                            
;                    dc:title "Langue d'origine"@fr, "Original language"@en;
                    dc:description "Langue de la fiche d'origine"@fr, "Language of the original record"@en.
fresh:CreationDate rdf:type owl:Class;
                        dc:identifier "E-006"^^xsd:anyURI;
                        rdfs:subClassOf fresh:TechnicalInfo

,
                                    [rdf:type owl:Restriction;
                                    owl:onProperty fresh:hasValue;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger;
                                    owl:onClass tfo:nan];
                            
;                    dc:title "Date du 1er enregistrement"@fr, "First record date"@en;
                    dc:description "Indique la date à laquelle la fiche a été enregistrée pour la première fois dans le catalogue FReSH"@fr, "Indicates the date on which the record was first registered in the FReSH catalogue"@en.
fresh:LastUpdatedAuto rdf:type owl:Class;
                        dc:identifier "E-007"^^xsd:anyURI;
                        rdfs:subClassOf fresh:TechnicalInfo

,
                                    [rdf:type owl:Restriction;
                                    owl:onProperty fresh:hasValue;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger;
                                    owl:onClass tfo:nan];
                            
;                    dc:title "Date de la dernière MAJ automatique"@fr, "Last automatic update date"@en;
                    dc:description "Indique la date de la dernière mise à jour automatique (import) de la fiche"@fr, "Indicates the date of the last automatic update (import) of the record"@en.
fresh:LastUpdatedManual rdf:type owl:Class;
                        dc:identifier "E-008"^^xsd:anyURI;
                        rdfs:subClassOf fresh:TechnicalInfo

,
                                    [rdf:type owl:Restriction;
                                    owl:onProperty fresh:hasValue;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger;
                                    owl:onClass tfo:nan];
                            
;                    dc:title "Date de la dernière MAJ manuelle"@fr, "Last manual update date"@en;
                    dc:description "Indique la date de la dernière mise à jour manuelle de la fiche"@fr, "Indicates the date of the last manual update of the record"@en.
fresh:RespValidation rdf:type owl:Class;
                        dc:identifier "E-009"^^xsd:anyURI;
                        rdfs:subClassOf fresh:TechnicalInfo

,
                                    [rdf:type owl:Restriction;
                                    owl:onProperty fresh:hasDatatype;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger;
                                    owl:onDataRange xsd:boolean];
                            
;                    dc:title "Complétion/validation par le responsable"@fr, "Completion/validation by the responsible person"@en;
                    dc:description "Indique si la fiche a été validée par le responsable scientifique de l'étude"@fr, "Indicates whether the record has been validated by the study's principal investigator"@en.
fresh:AutoTranslation rdf:type owl:Class;
                        dc:identifier "E-010"^^xsd:anyURI;
                        rdfs:subClassOf fresh:TechnicalInfo

,
                                    [rdf:type owl:Restriction;
                                    owl:onProperty fresh:hasDatatype;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger;
                                    owl:onDataRange xsd:boolean];
                            
;                    dc:title "Traduction automatique"@fr, "Automatic translation"@en;
                    dc:description "Indique si la fiche a été traduite automatiquement"@fr, "Indicates whether the record has been automatically translated"@en.
fresh:Status rdf:type owl:Class;
                        dc:identifier "E-011"^^xsd:anyURI;
                        rdfs:subClassOf fresh:TechnicalInfo

,
                                    [rdf:type owl:Restriction;
                                    owl:onProperty fresh:hasValue;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger;
                                    owl:onClass tfo:Status];
                            
;                    dc:title "Statut"@fr, "Status"@en;
                    dc:description "Statut actuel de la fiche des métadonnées dans le catalogue"@fr, "Current status of the metadata record in the catalogue"@en.
fresh:MetadataContributor rdf:type owl:Class;
                        dc:identifier "S-004"^^xsd:anyURI;
                        rdfs:subClassOf fresh:TechnicalInfo

;                    dc:title "Contributeur de la fiche de métadonnées"@fr, "Metadata Contributor"@en;
                    dc:description "Personne ou organisation chargée de renseigner les informations d’une étude dans le catalogue FReSH en complétant le formulaire en ligne"@fr, "Person or organization responsible for submitting study information to the FReSH catalogue by completing the online form"@en.
fresh:ContributorName rdf:type owl:Class;
                        dc:identifier "E-014"^^xsd:anyURI;
                        rdfs:subClassOf fresh:MetadataContributor

,
                                    [rdf:type owl:Restriction;
                                    owl:onProperty fresh:hasDatatype;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger;
                                    owl:onDataRange xsd:string];
                            
;                    dc:title "Prénom NOM"@fr, "Last name – First name"@en;
                    dc:description "Nom et prénom de la personne qui renseigne la fiche des métadonnées"@fr, "Full name of the person entering the metadata record"@en.
fresh:ContributorAffiliation rdf:type owl:Class;
                        dc:identifier "E-015"^^xsd:anyURI;
                        rdfs:subClassOf fresh:MetadataContributor

,
                                    [rdf:type owl:Restriction;
                                    owl:onProperty fresh:hasDatatype;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger;
                                    owl:onDataRange xsd:string];
                            
;                    dc:title "Affiliation"@fr, "Affiliation"@en;
                    dc:description "Affiliation de la personne qui renseigne la fiche des métadonnées"@fr, "Affiliation of the person entering the metadata record"@en.
fresh:StudyRelatedInfo rdf:type owl:Class;
                        dc:identifier "S-064"^^xsd:anyURI;
                        rdfs:subClassOf fresh:FreshSchema

