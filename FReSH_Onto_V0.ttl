###  https://purl.org/fresh/FReSH_OnTO#Masking
fresh:Masking rdf:type owl:Class ;
              rdfs:subClassOf fresh:InterventionalStudy ;
              dc:description "A study design strategy in which one or more parties involved in the study, such as the investigator or participants, do not know which participants have been assigned which interventions."@en ,
                             "Stratégie de conception d'une étude dans laquelle une ou plusieurs parties impliquées dans l'étude, telles que l'investigateur ou les participants, ne savent pas quels participants ont été assignés à quelles interventions. "@fr ;
              dc:identifier "S-031"^^xsd:anyURI ;
              dc:title "Insu"@fr ,
                       "Masking"@en .


###  https://purl.org/fresh/FReSH_OnTO#MaskingType
fresh:MaskingType rdf:type owl:Class ;
                  rdfs:subClassOf fresh:Masking ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty fresh:hasValue ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass tfo:MaskingType
                                  ] ;
                  dc:description "Indicates whether the study is conducted open-label (all parties know the assigned intervention) or with masking (at least one party is unaware of the assigned intervention)."@en ,
                                 "Indique si l’étude est conduit en ouvert (toutes les parties connaissent l’intervention attribuée) ou avec insu (au moins une partie est tenue dans l’ignorance de l’intervention attribuée)."@fr ;
                  dc:identifier "E-068"^^xsd:anyURI ;
                  dc:title "Masking type"@en ,
                           "Mode d'insu"@fr .


