                 dc:description "Cette section décrit différents aspects d'accès aux données recueillies au cours de l'étude."@fr ,
                                "This section describes various aspects of accessing the data collected during the study."@en ;
                 dc:identifier "S-053"^^xsd:anyURI ;
                 dc:title "Accès aux données"@fr ,
                          "Data access"@en .


###  https://purl.org/fresh/FReSH_OnTO#DataAccessRequestTool
fresh:DataAccessRequestTool rdf:type owl:Class ;
                            rdfs:subClassOf fresh:DataAvailability ;
                            dc:description "Cette section regroupe les informations relatives à l’existence éventuelle d’un outil d'accès aux données"@fr ,
                                           "This section contains information about the possible presence of a data access request tool"@en ;
                            dc:identifier "S-054"^^xsd:anyURI ;
                            dc:title "Data access request tool"@en ,
                                     "Outil de demande d'accès aux données"@fr .


###  https://purl.org/fresh/FReSH_OnTO#DataAccessRequestToolAvailable
fresh:DataAccessRequestToolAvailable rdf:type owl:Class ;
                                     rdfs:subClassOf fresh:DataAccessRequestTool ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty fresh:hasDatatype ;
                                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                       owl:onDataRange xsd:boolean
                                                     ] ;
                                     dc:description "Indicates whether a tool (platform, online form, or other system) is available for submitting a request for access to data."@en ,
                                                    "Indique si un outil (plateforme, formulaire en ligne ou autre système) permettant de formuler une demande d’accès aux données est disponible."@fr ;
                                     dc:identifier "E-127"^^xsd:anyURI ;
                                     dc:title "A data access request tool is it available ?"@en ,
                                              "Existe-t-il un outil de demande d'accès aux données ?"@fr .


