###  https://purl.org/fresh/FReSH_OnTO#IndividualDataAccess
fresh:IndividualDataAccess rdf:type owl:Class ;
                           rdfs:subClassOf fresh:DataAvailability ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty fresh:hasValue ;
                                             owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onClass tfo:IndividualDataAccess
                                           ] ;
                           dc:description "Individual data availability status at the end of the collect"@en ,
                                          "Statut de disponibilité des données individuelles à la fin de la collecte"@fr ;
                           dc:identifier "E-125"^^xsd:anyURI ;
                           dc:title "Access to individual data"@en ,
                                    "Accès aux données individuelles"@fr .


###  https://purl.org/fresh/FReSH_OnTO#Intervention
fresh:Intervention rdf:type owl:Class ;
                   rdfs:subClassOf fresh:InterventionalStudy ,
                                   fresh:ObservationalStudy ;
                   dc:description "Any process, action or factor to which participants are subjected or exposed, and which is the subject of an observational study to assess its effects on health."@en ,
                                  "Tout processus, action ou facteur auquel les participants sont soumis ou exposés, et qui fait l’objet d’une étude observationnelle afin d’évaluer ses effets sur la santé."@fr ;
                   dc:identifier "S-039"^^xsd:anyURI ;
                   dc:title "Facteur, processus ou exposition étudié"@fr ,
                            "Studied factor, process, or exposure"@en .


###  https://purl.org/fresh/FReSH_OnTO#InterventionName
fresh:InterventionName rdf:type owl:Class ;
                       rdfs:subClassOf fresh:Intervention ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty fresh:hasDatatype ;
                                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onDataRange xsd:string
                                       ] ;
                       dc:description "Le nom spécifique de l'action, du facteur ou de l'exposition tel qu'il est mentionné dans l'étude. Les facteurs comprennent différents produits de santé ou des approches non invasives, telles que l'éducation ou la modification du régime alimentaire et de l'exercice physique. Les expositions peuvent concerner par exemple des habitudes de vie, des facteurs environnementaux ou des antécédents médicaux."@fr ,
                                      "The specific name of the action, factor or exposure as it is referred to in the study. Factors include various health products or non-invasive approaches, such as education or changes to diet and exercise. Exposures may include, for example, lifestyle habits, environmental factors, or medical history."@en ;
                       dc:identifier "E-082"^^xsd:anyURI ;
                       dc:title "Factor/exposure name"@en ,
                                "Nom du facteur ou de l'exposition"@fr .


###  https://purl.org/fresh/FReSH_OnTO#InterventionType
fresh:InterventionType rdf:type owl:Class ;
                       rdfs:subClassOf fresh:Intervention ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty fresh:hasValue ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass tfo:InterventionType
                                       ] ;
                       dc:description "Selection of the category that best describes the factor or the exposure from the predefined list of options."@en ,
                                      "Sélection de la catégorie qui décrit le mieux le facteur ou l'exposition, à partir de la liste prédéfinie d'options."@fr ;
                       dc:identifier "E-083"^^xsd:anyURI ;
                       dc:title "Factor/exposure type"@en ,
                                "Type de facteur ou d'exposition"@fr .


###  https://purl.org/fresh/FReSH_OnTO#InterventionTypeOther
fresh:InterventionTypeOther rdf:type owl:Class ;
                            rdfs:subClassOf fresh:Intervention ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty fresh:hasDatatype ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onDataRange xsd:string
                                            ] ;
                            dc:description "Specifies the type of factor or exposure if ‘Other’ was selected above."@en ,
                                           "Spécifie le type du facteur ou d'exposition si « Autre » a été sélectionné ci-dessus."@fr ;
                            dc:identifier "E-084"^^xsd:anyURI ;
                            dc:title "Autre type de facteur ou d'exposition, précisions"@fr ,
                                     "Other factor/exposure type, details"@en .


###  https://purl.org/fresh/FReSH_OnTO#InterventionalStudy
fresh:InterventionalStudy rdf:type owl:Class ;
                          rdfs:subClassOf fresh:StudyMethodology ;
                          dc:description "Research in which investigators carry out an intentional action or change in a target group (e.g., medical treatment, prevention program, organisational change, educational or social action) with the aim of evaluating its effects on health, behaviors, or health-related practices."@en ,
                                         "Une recherche dans laquelle les investigateurs réalisent une action ou une modification intentionnelle dans un groupe cible (ex. : traitement médical, programme de prévention, changement organisationnel, action éducative ou sociale), dans le but d’en évaluer les effets sur la santé, les comportements, ou les pratiques liés à la santé."@fr ;
                          dc:identifier "S-029"^^xsd:anyURI ;
                          dc:title "Etude interventionnelle (expérimentale)"@fr ,
                                   "Interventional Study"@en .


###  https://purl.org/fresh/FReSH_OnTO#InterventionalStudyModel
fresh:InterventionalStudyModel rdf:type owl:Class ;
                               rdfs:subClassOf fresh:InterventionalStudy ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty fresh:hasValue ;
                                                 owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                 owl:onClass tfo:InterventionnalStudyModel
                                               ] ;
                               dc:description "Conception générale de la stratégie d'attribution des interventions aux participants d'une étude clinique. Les types de modèles d'intervention comprennent : l'attribution à un seul groupe, l'attribution parallèle, l'attribution croisée et l'attribution factorielle."@fr ,
                                              "The general design of the strategy for assigning interventions to participants in a clinical study. Types of intervention models include: single group assignment, parallel assignment, cross-over assignment, and factorial assignment."@en ;
                               dc:identifier "E-065"^^xsd:anyURI ;
                               dc:title "Intervention model"@en ,
                                        "Schéma d’intervention"@fr .


###  https://purl.org/fresh/FReSH_OnTO#IsActiveFollowUp
fresh:IsActiveFollowUp rdf:type owl:Class ;
                       rdfs:subClassOf fresh:ActiveFollowUp ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty fresh:hasDatatype ;
                                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onDataRange xsd:boolean
                                       ] ;
                       dc:description "Indicates whether participants are followed over time within the study and the method used."@en ,
                                      "Indique si les participants font l’objet d’un suivi actif dans le cadre de l’étude et la modalité du suivi"@fr ;
                       dc:identifier "E-098"^^xsd:anyURI ;
                       dc:title "It is an active follow-up?"@en ,
                                "Un suivi actif des participants est-il réalisé ?"@fr .


###  https://purl.org/fresh/FReSH_OnTO#IsClinicalTrial
fresh:IsClinicalTrial rdf:type owl:Class ;
                      rdfs:subClassOf fresh:InterventionalStudy ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty fresh:hasDatatype ;
                                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:boolean
                                      ] ;
                      dc:identifier "E-153"^^xsd:anyURI ;
                      dc:title "Is this a clinical trial?"@en ,
                               "S'agit-il d'un essai clinique?"@fr .


###  https://purl.org/fresh/FReSH_OnTO#IsContributorPI
fresh:IsContributorPI rdf:type owl:Class ;
                      rdfs:subClassOf fresh:AdministrativeInformation ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty fresh:hasDatatype ;
                                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:boolean
                                      ] ;
                      dc:identifier "E-152"^^xsd:anyURI ;
                      dc:title "Are you the Principal Investigator (PI) of the study ?"@en ,
                               "Etes-vous l'investigateur principal (PI) de l'étude ?"@fr .


###  https://purl.org/fresh/FReSH_OnTO#IsDataIntegration
fresh:IsDataIntegration rdf:type owl:Class ;
                        rdfs:subClassOf fresh:DataCollectionIntegration ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty fresh:hasDatatype ;
                                          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onDataRange xsd:boolean
                                        ] ;
                        dc:description "Indicates whether pre-existing individual data from third-party sources were used in the study."@en ,
                                       "Indique si les données individuelles préexistantes issues de sources tierces ont été utilisées dans le cadre de l'étude"@fr ;
                        dc:identifier "E-101"^^xsd:anyURI ;
                        dc:title "Are individual data from other sources reused in this study?"@en ,
                                 "Des données individuelles provenant d'autres sources sont-elles réutilisées dans le cadre de cette étude ?"@fr .


###  https://purl.org/fresh/FReSH_OnTO#IsHealthTheme
fresh:IsHealthTheme rdf:type owl:Class ;
                    rdfs:subClassOf fresh:Theme ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty fresh:hasDatatype ;
                                      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onDataRange xsd:boolean
                                    ] ;
                    dc:identifier "E-169"^^xsd:anyURI ;
                    dc:title "Does the study cover one or more medical speciality(ies)?"@en ,
                             "L'étude porte-t-elle sur une ou plusieurs spécialité(s) médicale(s) ?"@fr .


