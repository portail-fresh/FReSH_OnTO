    fresh:terminologies rdf:type owl:Class .


    tfo:Language rdf:type owl:Class ;
        rdfs:subClassOf fresh:terminologies ;
        dcterms:identifier term:FLG ;
        dcterms:title 'Langue'@fr , 'Language'@en ;
        dcterms:description 'Concepts utilisés pour décrire les champs OriginLang et VersionLang du schéma de métadonnées FReSH.'@fr , 'Terms used to describe the fields OriginLang and VersionLang in the FReSH metadata schema.'@en ;
        dcterms:creator fresh: ;
        pav:createdOn "2026-01-05"^^xsd:date ;
        pav:lastUpdatedOn '2026-04-07' ;


    
 
        fresh:metadataConcerned 'OriginLang';


            
 
        fresh:metadataConcerned 'VersionLang';


            
 
