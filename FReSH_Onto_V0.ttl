fresh:AllocationMode rdf:type owl:Class;
                        dc:identifier "E-066"^^xsd:anyURI;
                        rdfs:subClassOf fresh:Allocation

,
                                    [rdf:type owl:Restriction;
                                    owl:onProperty fresh:hasValue;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger;
                                    owl:onClass tfo:AllocationMode];
                            
;                    dc:title "Mode d'allocation"@fr, "Allocation type"@en;
                    dc:description "Les modes d'allocation sont l'allocation randomisée et l'allocation non randomisée. "@fr, "The types of allocation are randomized allocation and nonrandomized."@en.
