    fresh:terminologies rdf:type owl:Class .


    tfo:AllocationUnit rdf:type owl:Class ;
        rdfs:subClassOf fresh:terminologies ;
        dcterms:identifier term:FAU ;
        dcterms:title 'Unité d\'allocation'@fr , 'Allocation Type'@en ;
        dcterms:description 'Concepts utilisés pour décrire le champ AllocationUnit du schéma de métadonnées FReSH.'@fr , 'Terms used to describe the field AllocationUnit in the FReSH metadata schema.'@en ;
        dcterms:creator fresh: ;
        pav:createdOn "2026-01-05"^^xsd:date ;
        pav:lastUpdatedOn '2026-04-07' ;


    
 
        fresh:metadataConcerned 'AllocationUnit';


        
 
        dcterms:license 'https://creativecommons.org/licenses/by-nc-sa/4.0/' .


            
        tfo:FAU6589 rdf:type owl:NamedIndividual, tfo:AllocationUnit ;
            skos:prefLabel 'Individuelle'@fr , 'Individuelle'@en ;
            dc:title 'Individuelle'@fr , 'Individuelle'@en ;
        

            skos:definition 'Intervention attribuée au niveau individuel.'@fr, 'Individual-level intervention.'@en ;
        

        dcterms:identifier 'FAU6589' .
    

        tfo:FAU6745 rdf:type owl:NamedIndividual, tfo:AllocationUnit ;
            skos:prefLabel 'Cluster'@fr , 'Cluster'@en ;
            dc:title 'Cluster'@fr , 'Cluster'@en ;
        

            skos:definition 'Intervention attribuée au niveau du cluster.'@fr, 'Intervention allocated at cluster level.'@en ;
        

        dcterms:identifier 'FAU6745' .
    